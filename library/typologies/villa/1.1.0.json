  "measures": [
    {
      "id": "bedrooms",
      "name": "Bedrooms",
      "of": "count_bedroom + count_master_bedroom",
      "digits": 0
    },
    {
      "id": "bathrooms",
      "name": "Bathrooms",
      "of": "count_bathroom",
      "digits": 0
    },
    {
      "id": "carpet-area",
      "name": "Carpet area",
      "of": "net",
      "unit": "m²",
      "digits": 0,
      "better": "higher",
      "about": "Every room inside its walls (a city's own rule may differ: change it for the project)."
    },
    {
      "id": "built-up-area",
      "name": "Built-up area",
      "of": "built",
      "unit": "m²",
      "digits": 0
    },
    {
      "id": "far",
      "name": "FAR",
      "of": "built / area_plot",
      "digits": 2,
      "about": "Built area over the plot's; once the plot is drawn."
    },
    {
      "id": "ground-coverage",
      "name": "Ground coverage",
      "of": "built_0 / area_plot * 100",
      "unit": "%",
      "digits": 0,
      "about": "The ground floor's built area over the plot's; once the plot is drawn."
    }
  ],
  "checks": [
    {
      "id": "V-kitchen",
      "code": "T7",
      "of": "building",
      "when": "rooms > 0 && count_kitchen == 0",
      "say": "There is no kitchen yet: a house usually has one."
    },
    {
      "id": "V-stair",
      "code": "T7",
      "of": "building",
      "when": "floors > 1 && count_stair == 0",
      "say": "The rooms are on {floors} floors and there is no stair yet."
    },
    {
      "id": "V-toilet-floor",
      "code": "T7",
      "of": "level",
      "when": "rooms > 1 && count_bathroom + count_powder_room == 0",
      "say": "{level_name} has no bathroom or powder room: a floor people live on usually has one."
    }
  ]
}