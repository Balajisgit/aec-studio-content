{
  "id": "furniture.bench-6@1.0.0",
  "name": "Bench for 6",
  "contract": "furniture.bench-6",
  "kind": "furniture",
  "behaves": [],
  "about": "Six desks, three facing three across a low screen, with their chairs. Width and depth are one person's.",
  "params": {
    "width": 1400,
    "depth": 700,
    "height": 740
  },
  "limits": {
    "width": {
      "min": 1000,
      "max": 1800,
      "step": 50
    },
    "depth": {
      "min": 600,
      "max": 900,
      "step": 10
    },
    "height": {
      "min": 680,
      "max": 780,
      "step": 10
    }
  },
  "symbol2d": [
    {
      "name": "top",
      "shape": "rect",
      "at": [
        "0",
        "0"
      ],
      "size": [
        "3 * width",
        "2 * depth"
      ],
      "style": "fill",
      "slot": "wood"
    },
    {
      "name": "chairs",
      "shape": "rect",
      "at": [
        "((i % 3) - 1.0) * width",
        "(i < 3 ? -1 : 1) * (depth + 330)"
      ],
      "size": [
        "460",
        "460"
      ],
      "style": "thin",
      "count": "6"
    },
    {
      "name": "screen",
      "shape": "rect",
      "at": [
        "0",
        "0"
      ],
      "size": [
        "3 * width",
        "30"
      ],
      "style": "hidden"
    }
  ],
  "primitive3d": [
    {
      "name": "ends",
      "shape": "box",
      "at": [
        "(i == 0 ? -1 : 1) * ((3 * width) / 2 - 20)",
        "0",
        "0"
      ],
      "size": [
        "40",
        "(2 * depth) - 100",
        "height - 25"
      ],
      "slot": "frame",
      "count": "2"
    },
    {
      "name": "top",
      "shape": "box",
      "at": [
        "0",
        "0",
        "height - 25"
      ],
      "size": [
        "3 * width",
        "2 * depth",
        "25"
      ],
      "slot": "wood"
    },
    {
      "name": "screen",
      "shape": "box",
      "at": [
        "0",
        "0",
        "height"
      ],
      "size": [
        "3 * width",
        "30",
        "380"
      ],
      "slot": "fabric"
    },
    {
      "name": "chairs: seats",
      "shape": "box",
      "at": [
        "((i % 3) - 1.0) * width",
        "(i < 3 ? -1 : 1) * (depth + 330)",
        "400"
      ],
      "size": [
        "460",
        "460",
        "60"
      ],
      "slot": "fabric",
      "count": "6"
    },
    {
      "name": "chairs: backs",
      "shape": "box",
      "at": [
        "((i % 3) - 1.0) * width",
        "((i < 3 ? -1 : 1) * (depth + 330)) + ((i < 3 ? -1 : 1) * 205)",
        "460"
      ],
      "size": [
        "460",
        "50",
        "420"
      ],
      "slot": "fabric",
      "count": "6"
    }
  ]
}
