{
  "id": "furniture.shower@1.0.0",
  "name": "Shower",
  "contract": "furniture.shower",
  "role": "furniture",
  "about": "A shower tray with a fixed glass screen on half of its open front.",
  "params": {
    "width": 900,
    "depth": 900,
    "screen_height": 2000
  },
  "limits": {
    "width": {
      "min": 700,
      "max": 1400,
      "step": 10
    },
    "depth": {
      "min": 700,
      "max": 1400,
      "step": 10
    },
    "screen_height": {
      "min": 1800,
      "max": 2200,
      "step": 10
    }
  },
  "symbol2d": [
    {
      "name": "tray",
      "shape": "rect",
      "at": [
        "0",
        "0"
      ],
      "size": [
        "width",
        "depth"
      ],
      "style": "fill",
      "slot": "ceramic"
    },
    {
      "name": "falls",
      "shape": "line",
      "count": "2",
      "from": [
        "-width / 2",
        "(i == 0 ? -1 : 1) * depth / 2"
      ],
      "to": [
        "width / 2",
        "(i == 0 ? 1 : -1) * depth / 2"
      ],
      "style": "thin"
    },
    {
      "name": "drain",
      "shape": "circle",
      "at": [
        "0",
        "0"
      ],
      "r": "40",
      "style": "thin"
    },
    {
      "name": "screen",
      "shape": "line",
      "from": [
        "0",
        "depth / 2 - 5"
      ],
      "to": [
        "width / 2",
        "depth / 2 - 5"
      ]
    }
  ],
  "primitive3d": [
    {
      "name": "tray",
      "shape": "box",
      "at": [
        "0",
        "0",
        "0"
      ],
      "size": [
        "width",
        "depth",
        "50"
      ],
      "slot": "ceramic"
    },
    {
      "name": "screen",
      "shape": "box",
      "at": [
        "width / 4",
        "depth / 2 - 5",
        "50"
      ],
      "size": [
        "width / 2",
        "10",
        "screen_height"
      ],
      "slot": "glass"
    },
    {
      "name": "head",
      "shape": "cylinder",
      "at": [
        "0",
        "-depth / 2 + 60",
        "screen_height"
      ],
      "size": [
        "40",
        "100"
      ],
      "slot": "metal"
    }
  ]
}
