{
  "id": "window.generic@1.1.0",
  "name": "Window",
  "contract": "window.generic",
  "kind": "window",
  "behaves": [
    "opening"
  ],
  "on": "segment",
  "about": "A window whose make is not chosen yet: 1.2 m high on a 900 mm sill. Swap it for the window it is. align says where its glass sits in the wall's depth: in the middle, or at the wall's left or right face (R156).",
  "length": {
    "default": 1200,
    "min": 300,
    "max": 4000
  },
  "params": {
    "height": 1200,
    "sill": 900,
    "align": "centre"
  },
  "limits": {
    "height": {
      "min": 300,
      "max": 3000,
      "step": 50
    },
    "sill": {
      "min": 0,
      "max": 2400,
      "step": 50
    },
    "align": {
      "options": [
        "centre",
        "left",
        "right"
      ]
    }
  },
  "symbol2d": [
    {
      "name": "frame",
      "shape": "rect",
      "style": "thin",
      "at": [
        "0",
        "0"
      ],
      "size": [
        "length",
        "host_thickness > 0 ? host_thickness : 100"
      ]
    },
    {
      "name": "glass",
      "shape": "line",
      "from": [
        "-length / 2",
        "align == 'left' ? max(0, (host_thickness - 20) / 2) : align == 'right' ? -max(0, (host_thickness - 20) / 2) : 0"
      ],
      "to": [
        "length / 2",
        "align == 'left' ? max(0, (host_thickness - 20) / 2) : align == 'right' ? -max(0, (host_thickness - 20) / 2) : 0"
      ]
    }
  ],
  "primitive3d": [
    {
      "name": "glass",
      "shape": "box",
      "slot": "glass",
      "at": [
        "0",
        "align == 'left' ? max(0, (host_thickness - 20) / 2) : align == 'right' ? -max(0, (host_thickness - 20) / 2) : 0",
        "sill"
      ],
      "size": [
        "length",
        "20",
        "height"
      ]
    },
    {
      "name": "wall below",
      "shape": "box",
      "slot": "host",
      "when": "host_thickness > 0 && sill > 0",
      "at": [
        "0",
        "0",
        "0"
      ],
      "size": [
        "length",
        "host_thickness",
        "sill"
      ]
    },
    {
      "name": "wall above",
      "shape": "box",
      "slot": "host",
      "when": "host_thickness > 0 && host_height > sill + height",
      "at": [
        "0",
        "0",
        "sill + height"
      ],
      "size": [
        "length",
        "host_thickness",
        "host_height - sill - height"
      ]
    }
  ]
}
