    "thickness": {
      "min": 30,
      "max": 120,
      "step": 5
    },
    "height": {
      "min": 0,
      "max": 30000,
      "step": 50
    }
  },
  "symbol2d": [
    {
      "name": "wall",
      "shape": "band",
      "style": "fill",
      "across": [
        "-thickness / 2",
        "thickness / 2"
      ]
    }
  ],
  "primitive3d": [
    {
      "name": "wall",
      "shape": "band",
      "across": [
        "-thickness / 2",
        "thickness / 2"
      ],
      "z": "0",
      "height": "height > 0 ? height : rise - slab_above",
      "slot": "glass"
    }
  ]
