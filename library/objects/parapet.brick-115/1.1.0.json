{
  "id": "parapet.brick-115@1.1.0",
  "name": "Parapet 115",
  "contract": "parapet.brick-115",
  "kind": "parapet",
  "behaves": [
    "band"
  ],
  "on": "segment",
  "about": "A half-brick parapet round a terrace or a balcony, 1 m high above its floor by default. A band like a wall: it joins the walls and parapets it meets, and the relationships leave its height alone (it is not a wall). justify says where it sits on its line as drawn: centre, or wholly to its left or its right (the line is then one of its faces). corner (mitre or butt) and priority (the higher carries on) say how it meets others of its kind (R156).",
  "length": {
    "default": 3000,
    "min": 100,
    "max": 100000
  },
  "params": {
    "thickness": 115,
    "height": 1000,
    "justify": "centre",
    "corner": "mitre",
    "priority": 0
  },
  "limits": {
    "thickness": {
      "min": 75,
      "max": 300,
      "step": 5
    },
    "height": {
      "min": 600,
      "max": 1500,
      "step": 50
    },
    "justify": {
      "options": [
        "centre",
        "left",
        "right"
      ]
    },
    "corner": {
      "options": [
        "mitre",
        "butt"
      ]
    },
    "priority": {
      "min": 0,
      "max": 9,
      "step": 1
    }
  },
  "symbol2d": [
    {
      "name": "wall",
      "shape": "band",
      "style": "fill",
      "across": [
        "justify == 'left' ? 0 : justify == 'right' ? -thickness : -thickness / 2",
        "justify == 'left' ? thickness : justify == 'right' ? 0 : thickness / 2"
      ]
    }
  ],
  "primitive3d": [
    {
      "name": "parapet",
      "shape": "band",
      "across": [
        "justify == 'left' ? 0 : justify == 'right' ? -thickness : -thickness / 2",
        "justify == 'left' ? thickness : justify == 'right' ? 0 : thickness / 2"
      ],
      "z": "0",
      "height": "height"
    }
  ]
}
