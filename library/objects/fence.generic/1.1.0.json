      "min": 20,
      "max": 500,
      "step": 5
    },
    "height": {
      "min": 300,
      "max": 5000,
      "step": 50
    },
    "justify": {
      "options": [
        "centre",
        "left",
        "right"
      ]
    },
    "corner": {
      "options": [
        "mitre",
        "butt"
      ]
    },
    "priority": {
      "min": 0,
      "max": 9,
      "step": 1
    }
  },
  "symbol2d": [
